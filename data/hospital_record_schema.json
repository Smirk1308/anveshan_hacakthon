{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SahayAI Hospital Record",
  "type": "object",
  "required": ["id", "name", "type", "capabilities", "verified"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "lat": {
      "type": ["number", "null"],
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180
    },
    "address": {
      "type": ["string", "null"]
    },
    "phone": {
      "type": ["string", "null"]
    },
    "type": {
      "enum": ["government", "private", "trust"]
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified": {
      "type": ["string", "null"],
      "format": "date"
    },
    "verified_by": {
      "type": ["string", "null"]
    },
    "source": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "research_checked_on": {
      "type": "string",
      "format": "date"
    },
    "source_kind": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "location_verified": {
      "type": "boolean"
    },
    "location_source_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "notes": {
      "type": "string"
    },
    "department_beds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["department_id", "department_name", "total", "available"],
        "properties": {
          "department_id": { "type": "string" },
          "department_name": { "type": "string" },
          "total": { "type": "integer", "minimum": 0 },
          "available": { "type": "integer", "minimum": 0 },
          "last_updated": { "type": ["string", "null"] }
        }
      }
    }
  },
  "additionalProperties": true
}
