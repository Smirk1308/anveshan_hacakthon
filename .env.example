GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# Choose at most one provider per request: none, gemini, groq, or ollama.
LLM_PROVIDER=none
# Explicitly enable before emergency text can be sent to the selected model provider.
LLM_ALLOW_USER_TEXT_SHARING=false
LLM_TIMEOUT_SECONDS=6
ONLY_VERIFIED=false
FRONTEND_ORIGIN=http://localhost:3000
# Frontend origin used when the two branches are combined.
NEXT_PUBLIC_TRIAGE_API_URL=http://localhost:8000
# Set after the team hand-verifies hospital records.
HOSPITALS_PATH=data/hospitals.json
# Basic in-memory per-process limit for POST /api/triage.
TRIAGE_RATE_LIMIT_REQUESTS=30
TRIAGE_RATE_LIMIT_WINDOW_SECONDS=60
# Optional local speech-to-text. Install requirements-voice.txt to enable.
VOICE_MODEL=small
# auto tries NVIDIA CUDA first and falls back to CPU int8; or set cpu/cuda explicitly.
VOICE_DEVICE=auto
VOICE_RATE_LIMIT_REQUESTS=10
VOICE_RATE_LIMIT_WINDOW_SECONDS=60
VOICE_MAX_AUDIO_BYTES=10485760
# Nearby helper alerts: generate a VAPID key pair; keep the private key on the backend only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org
# Optional; default database file is ignored by Git.
NEARBY_DB_PATH=.data/nearby.sqlite3
